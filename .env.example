# Copy to .env.local for local work; set the same keys in Vercel → Settings → Environment Variables.

# Search engines: only the production site with this "on" is indexable.
NEXT_PUBLIC_INDEXING=off
# Link guard in previews (production always guards).
NEXT_PUBLIC_LINK_GUARD=off

# Enquiries by email (Resend). Sending starts only when all are set and ENQUIRY_LIVE=on.
RESEND_API_KEY=
ENQUIRY_FROM="James Wild & Co <enquiries@jameswildco.com>"
ENQUIRY_TRIPS_TO=
ENQUIRY_LIVE=off
