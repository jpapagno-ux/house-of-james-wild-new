# Copy to .env.local for local work; set the same keys in Vercel → Settings → Environment Variables.

# Search engines: only the production site with this "on" is indexable.
NEXT_PUBLIC_INDEXING=off
# Link guard in previews (production always guards).
NEXT_PUBLIC_LINK_GUARD=off

# Enquiries by email (Resend). Sending starts only when all are set and ENQUIRY_LIVE=on.
RESEND_API_KEY=
ENQUIRY_FROM="James Wild & Co <hello@jameswildco.com>"
ENQUIRY_LIVE=off

# Partner Desk (Stage 1). Off unless exactly "on"; switch on for Preview only until James approves.
# Uses the same NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY as Booking Live.
# Invitation emails go through Resend (RESEND_API_KEY, ENQUIRY_FROM) only when ENQUIRY_LIVE=on,
# and never to .test addresses. SUPABASE_SERVICE_ROLE_KEY is NOT used by the desk.
NEXT_PUBLIC_PARTNER_DESK=off
